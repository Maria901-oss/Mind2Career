<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background Color -->
    <solid android:color="#FFFFFF"/>

    <!-- Border -->
    <stroke
        android:width="2dp"
        android:color="#D1C4E9"/>

    <!-- Rounded Corners -->
    <corners android:radius="10dp"/>

    <!-- Padding -->
    <padding
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp"/>

</shape>
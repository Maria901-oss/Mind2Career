<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".iamstudent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Top Illustration -->
        <ImageView
            android:id="@+id/topImage"
            android:layout_width="260dp"
            android:layout_height="220dp"
            android:layout_marginTop="50dp"
            android:layout_marginBottom="100dp"
            android:scaleType="centerCrop"
            android:src="@drawable/illustration5" />

        <!-- Heading -->
        <TextView
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="I am a"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginLeft="0dp"/>

        <!-- Sub Heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select your profile"
            android:layout_marginLeft="0dp"
            android:textSize="16sp"
            android:textColor="#777777"
            android:layout_marginBottom="30dp" />

        <!-- Student Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStudent"
            android:layout_width="260dp"
            android:layout_height="55dp"
            android:backgroundTint="#BA9AB2"
            android:text="Student"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:layout_marginTop="10dp" />

        <!-- Graduate Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGraduate"
            android:layout_width="260dp"
            android:layout_height="55dp"
            android:backgroundTint="#7516B5"
            android:text="Graduate"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:layout_marginTop="10dp" />

        <!-- Professional Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProfessional"
            android:layout_width="260dp"
            android:layout_height="55dp"
            android:backgroundTint="#BA9AB2"
            android:text="Professional"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3FF"
    android:fillViewport="true"
    android:fitsSystemWindows="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- PURPLE HEADER — fitsSystemWindows REMOVED -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#7B1FA2"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/baseline_arrow_back_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:backgroundTint="#00000000"
                android:contentDescription="Back" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mind2Career"
                    android:textColor="#E1BFFF"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Privacy Policy"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- CONTENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- MAIN CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Privacy Policy"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#2D2060"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last updated: May 2025"
                        android:textSize="10sp"
                        android:textColor="#9B8EC4"
                        android:layout_marginBottom="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="#EDE8FF"
                        android:layout_marginBottom="16dp" />

                    <!-- Section 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="16dp"
                            android:background="#7B1FA2"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1. Information We Collect"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#2D2060" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Full name and email address (provided during registration)\n• Career interests and assessment results\n• App usage data to improve your experience\n• Device information for technical support"
                        android:textSize="12sp"
                        android:textColor="#5F5A7A"
                        android:lineSpacingMultiplier="1.6"
                        android:layout_marginBottom="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="#EDE8FF"
                        android:layout_marginBottom="16dp" />

                    <!-- Section 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="16dp"
                            android:background="#7B1FA2"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2. How We Use Your Information"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#2D2060" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Provide personalized career path recommendations\n• Improve app features and user experience\n• Send important updates about your account\n• Analyze app performance and fix issues\n\nWe do NOT sell your personal data to any third parties."
                        android:textSize="12sp"
                        android:textColor="#5F5A7A"
                        android:lineSpacingMultiplier="1.6"
                        android:layout_marginBottom="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="#EDE8FF"
                        android:layout_marginBottom="16dp" />

                    <!-- Section 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="16dp"
                            android:background="#7B1FA2"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3. Data Security"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#2D2060" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mind2Career uses Firebase Authentication and Firestore, both secured by Google's industry-standard encryption. Your data is protected with secure HTTPS connections and we regularly review our security practices."
                        android:textSize="12sp"
                        android:textColor="#5F5A7A"
                        android:lineSpacingMultiplier="1.6"
                        android:layout_marginBottom="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="#EDE8FF"
                        android:layout_marginBottom="16dp" />

                    <!-- Section 4 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="16dp"
                            android:background="#7B1FA2"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4. Your Rights"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#2D2060" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Access the personal data we hold about you\n• Request correction of inaccurate data\n• Request deletion of your account and data\n• Opt out of non-essential communications\n\nTo exercise these rights, contact us at support@mind2career.com"
                        android:textSize="12sp"
                        android:textColor="#5F5A7A"
                        android:lineSpacingMultiplier="1.6"
                        android:layout_marginBottom="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="#EDE8FF"
                        android:layout_marginBottom="16dp" />

                    <!-- Section 5 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="16dp"
                            android:background="#7B1FA2"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5. Contact Us"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#2D2060" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="If you have any questions about this Privacy Policy, please contact us:"
                        android:textSize="12sp"
                        android:textColor="#5F5A7A"
                        android:lineSpacingMultiplier="1.6"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#F5F3FF"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📧  support@mind2career.com"
                            android:textSize="12sp"
                            android:textColor="#534AB7"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌐  www.mind2career.com"
                            android:textSize="12sp"
                            android:textColor="#534AB7" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- FOOTER BADGE -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#EDE8FF"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mind2Career"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#7B1FA2"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your career journey, your data — protected."
                        android:textSize="10sp"
                        android:textColor="#9B8EC4"
                        android:gravity="center"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="© 2025 Mind2Career. All rights reserved."
                        android:textSize="10sp"
                        android:textColor="#9B8EC4"
                        android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/main"
    android:layout_height="match_parent"
    android:background="#F0F4FA">

    <!-- LOADING -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="visible" />

    <!-- ERROR -->
    <LinearLayout
        android:id="@+id/errorLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="#666666"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:text="Something went wrong." />

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Try Again"
            android:backgroundTint="@color/button"
            android:paddingStart="32dp"
            android:paddingEnd="32dp" />
    </LinearLayout>

    <!-- MAIN CONTENT -->
    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ══════════════════════════════════════ -->
            <!-- TOP BAR                               -->
            <!-- ══════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:background="@color/secondarytext">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_arrow_back"
                    android:background="@drawable/circle_bg_light"
                    android:contentDescription="Back" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Mind2Career Recommendations"
                    android:textSize="15sp"
                    android:textColor="@color/primary"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_account_circle"
                    android:background="@drawable/circle_bg_blue"
                    android:padding="6dp"
                    android:contentDescription="Profile" />
            </LinearLayout>

            <!-- ══════════════════════════════════════ -->
            <!-- HERO CARD: Personality + Result       -->
            <!-- ══════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Personality label + Result badge row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PERSONALITY TYPE"
                                android:textSize="10sp"
                                android:textColor="@color/button"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/tvPersonalityType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary"
                                android:text="—" />
                        </LinearLayout>

                        <!-- Result badge -->
                        <LinearLayout
                            android:layout_width="62dp"
                            android:layout_height="62dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/circle_bg_blue">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Result"
                                android:textSize="9sp"
                                android:textColor="#BBDEFB"
                                android:letterSpacing="0.05" />

                            <TextView
                                android:id="@+id/tvResultPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/secondarytext"
                                android:text="0%" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Key Skills label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Key Skills:"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:layout_marginBottom="6dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:id="@+id/llSkillsHave"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical" />
                    </HorizontalScrollView>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="#E0E0E0"
                        android:layout_marginBottom="10dp" />

                    <!-- Grade + Field + Details -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvGradeField"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:textColor="#888888"
                            android:drawablePadding="4dp"
                            android:text="Computer Science Degree" />

                        <TextView
                            android:id="@+id/tvDetailsToggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DETAILS ▾"
                            android:textSize="11sp"
                            android:textColor="@color/button"
                            android:textStyle="bold"
                            android:letterSpacing="0.04"
                            android:paddingStart="8dp" />
                    </LinearLayout>

                    <!-- Expandable detail: personality insight (hidden by default) -->
                    <TextView
                        android:id="@+id/tvPersonalityInsight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="#555555"
                        android:lineSpacingMultiplier="1.5"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        android:text="—" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══════════════════════════════════════ -->
            <!-- JOURNEY HEADER                        -->
            <!-- ══════════════════════════════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Professional Journey"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:gravity="center"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Personalized path to success"
                android:textSize="13sp"
                android:textColor="#888888"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="24dp" />

            <!-- ══════════════════════════════════════ -->
            <!-- STEP 1: Suggested Field  (LEFT card)  -->
            <!-- ══════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="48dp">

                <!-- Icon + dashed line column -->
                <LinearLayout
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_laptop"
                        android:background="@drawable/circle_bg_blue"
                        android:padding="10dp"
                        android:contentDescription="Field icon" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/dashed_vertical_line"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <View android:layout_width="12dp" android:layout_height="match_parent" />

                <!-- Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginBottom="0dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SUGGESTED FIELD"
                            android:textSize="10sp"
                            android:textColor="@color/button"
                            android:letterSpacing="0.08"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvPrimaryCareer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A2E"
                            android:layout_marginBottom="6dp"
                            android:text="Software Engineering" />

                        <TextView
                            android:id="@+id/tvWhyCareer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="#666666"
                            android:lineSpacingMultiplier="1.5"
                            android:text="—" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Connector between Step 1 and Step 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:paddingStart="16dp">
                <LinearLayout
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal">
                    <View
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/dashed_vertical_line" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══════════════════════════════════════ -->
            <!-- STEP 2: Skills to Learn (RIGHT card)  -->
            <!-- ══════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="48dp"
                android:paddingEnd="16dp">

                <!-- Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SKILLS TO LEARN"
                            android:textSize="10sp"
                            android:textColor="@color/button"
                            android:letterSpacing="0.08"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary"
                            android:layout_marginBottom="10dp"
                            android:text="Core Technical Skills" />

                        <LinearLayout
                            android:id="@+id/llSkillsNeed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <View android:layout_width="12dp" android:layout_height="match_parent" />

                <!-- Icon + dashed line column -->
                <LinearLayout
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_star"
                        android:background="@drawable/circle_bg_blue"
                        android:padding="10dp"
                        android:contentDescription="Skills icon" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/dashed_vertical_line"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Connector -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:paddingEnd="16dp"
                android:gravity="right">
                <LinearLayout
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal">
                    <View
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/dashed_vertical_line" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══════════════════════════════════════ -->
            <!-- STEP 3: Suggested Courses (LEFT card) -->
            <!-- ══════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="48dp">

                <LinearLayout
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_book"
                        android:background="@drawable/circle_bg_blue"
                        android:padding="10dp"
                        android:contentDescription="Courses icon" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/dashed_vertical_line"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <View android:layout_width="12dp" android:layout_height="match_parent" />

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SUGGESTED COURSES"
                            android:textSize="10sp"
                            android:textColor="@color/button"
                            android:letterSpacing="0.08"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A2E"
                            android:layout_marginBottom="10dp"
                            android:text="Toolbox Expansion" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvRoadmapSteps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Connector -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:paddingStart="16dp">
                <LinearLayout
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal">
                    <View
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/dashed_vertical_line" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══════════════════════════════════════ -->
            <!-- STEP 4: Growth Path (RIGHT card)      -->
            <!-- ══════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="48dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="24dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GROWTH PATH"
                            android:textSize="10sp"
                            android:textColor="#555555"
                            android:letterSpacing="0.08"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvAlt1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A2E"
                            android:layout_marginBottom="6dp"
                            android:text="Senior Tech Lead" />

                        <TextView
                            android:id="@+id/tvTimeline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="#666666"
                            android:lineSpacingMultiplier="1.5"
                            android:layout_marginBottom="10dp"
                            android:text="—" />

                        <TextView
                            android:id="@+id/tvAlt2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/button"
                            android:textStyle="bold"
                            android:text="" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <View android:layout_width="12dp" android:layout_height="match_parent" />

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_trending_up"
                    android:background="@drawable/circle_bg_blue"
                    android:padding="10dp"
                    android:contentDescription="Growth icon" />
            </LinearLayout>

            <!-- ══════════════════════════════════════ -->
            <!-- STRONG / WEAK SUBJECTS (conditional)  -->
            <!-- ══════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#F1F8E9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💪  STRONG SUBJECTS"
                        android:textSize="10sp"
                        android:textColor="@color/button"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:id="@+id/llStrongSubjects"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardWeak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="24dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFF3E0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📈  NEEDS IMPROVEMENT"
                        android:textSize="10sp"
                        android:textColor="#BF360C"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:id="@+id/llWeakSubjects"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══════════════════════════════════════ -->
            <!-- CTA BUTTONS                           -->
            <!-- ══════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="32dp">

                <Button
                    android:id="@+id/btnStartJourney"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="START THE JOURNEY 🚀"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:backgroundTint="@color/button"
                    android:layout_marginBottom="8dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>

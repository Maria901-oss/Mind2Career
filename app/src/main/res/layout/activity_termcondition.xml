<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3FF"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- PURPLE HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#7B1FA2"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:fitsSystemWindows="true">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/baseline_arrow_back_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:backgroundTint="#00000000"
                android:contentDescription="Back" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mind2Career"
                    android:textColor="#E1BFFF"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terms &amp; Conditions"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- CONTENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- MAIN CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Terms &amp; Conditions"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#2D2060"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last updated: May 2025"
                        android:textSize="10sp"
                        android:textColor="#9B8EC4"
                        android:layout_marginBottom="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="#EDE8FF"
                        android:layout_marginBottom="16dp" />

                    <!-- Section 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="16dp"
                            android:background="#9C27B0"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1. Acceptance of Terms"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#2D2060" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="By downloading and using Mind2Career, you agree to be bound by these Terms and Conditions. If you do not agree, please do not use our application."
                        android:textSize="12sp"
                        android:textColor="#5F5A7A"
                        android:lineSpacingMultiplier="1.6"
                        android:layout_marginBottom="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="#EDE8FF"
                        android:layout_marginBottom="16dp" />

                    <!-- Section 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="16dp"
                            android:background="#9C27B0"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2. Use of the App"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#2D2060" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Use the app only for lawful purposes\n• Provide accurate information during registration\n• Do not attempt to hack or reverse-engineer the app\n• Do not share your account credentials with others"
                        android:textSize="12sp"
                        android:textColor="#5F5A7A"
                        android:lineSpacingMultiplier="1.6"
                        android:layout_marginBottom="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="#EDE8FF"
                        android:layout_marginBottom="16dp" />

                    <!-- Section 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="16dp"
                            android:background="#9C27B0"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3. Career Guidance Disclaimer"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#2D2060" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Career recommendations provided by Mind2Career are based on AI analysis and are for informational purposes only. Always consult a qualified career advisor for important decisions."
                        android:textSize="12sp"
                        android:textColor="#5F5A7A"
                        android:lineSpacingMultiplier="1.6"
                        android:layout_marginBottom="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="#EDE8FF"
                        android:layout_marginBottom="16dp" />

                    <!-- Section 4 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="16dp"
                            android:background="#9C27B0"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4. Intellectual Property"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#2D2060" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="All content, logos, and features within Mind2Career are the intellectual property of the Mind2Career team. You may not copy, reproduce, or distribute any part without written permission."
                        android:textSize="12sp"
                        android:textColor="#5F5A7A"
                        android:lineSpacingMultiplier="1.6"
                        android:layout_marginBottom="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="#EDE8FF"
                        android:layout_marginBottom="16dp" />

                    <!-- Section 5 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="16dp"
                            android:background="#9C27B0"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5. Account Termination"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#2D2060" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="We reserve the right to suspend or terminate your account if you violate these terms. You may delete your account at any time by contacting our support team."
                        android:textSize="12sp"
                        android:textColor="#5F5A7A"
                        android:lineSpacingMultiplier="1.6"
                        android:layout_marginBottom="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="#EDE8FF"
                        android:layout_marginBottom="16dp" />

                    <!-- Section 6 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="16dp"
                            android:background="#9C27B0"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6. Contact Us"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#2D2060" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="For any questions regarding these Terms and Conditions:"
                        android:textSize="12sp"
                        android:textColor="#5F5A7A"
                        android:lineSpacingMultiplier="1.6"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#F5F3FF"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📧  support@mind2career.com"
                            android:textSize="12sp"
                            android:textColor="#534AB7"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌐  www.mind2career.com"
                            android:textSize="12sp"
                            android:textColor="#534AB7" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- FOOTER BADGE -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#EDE8FF"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mind2Career"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#7B1FA2"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="By using our app you accept these terms."
                        android:textSize="10sp"
                        android:textColor="#9B8EC4"
                        android:gravity="center"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="© 2025 Mind2Career. All rights reserved."
                        android:textSize="10sp"
                        android:textColor="#9B8EC4"
                        android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
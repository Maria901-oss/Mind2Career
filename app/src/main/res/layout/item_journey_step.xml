<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/journeyStepCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- Step number circle -->
        <TextView
            android:id="@+id/tvJourneyStepNum"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/button"
            android:background="@drawable/circle_bg_blue"
            android:layout_marginEnd="12dp" />

        <!-- Step content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvJourneyStepTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"
                android:layout_marginBottom="4dp"
                android:text="Step Title" />

            <TextView
                android:id="@+id/tvJourneyStepDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#666666"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="6dp"
                android:text="Description" />

            <TextView
                android:id="@+id/tvJourneyStepDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/button"
                android:textStyle="bold"
                android:text="⏱ 1 month" />

        </LinearLayout>

        <!-- Checkbox -->
        <CheckBox
            android:id="@+id/cbStepDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:buttonTint="@color/button"
            android:text="" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
